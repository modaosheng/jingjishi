{
  "name": "jingshi-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --experimental-strip-types --import ./tests/_registerLoader.mjs --test tests/*.test.ts",
    "verify": "npm run typecheck && npm test && npm run build",
    "cap:sync": "npm run build && cap sync android",
    "cap:open": "cap open android",
    "android": "npm run cap:sync && cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "mammoth": "^1.12.2",
    "pdfjs-dist": "^6.3.289",
    "pinia": "^4.0.3",
    "tesseract.js": "^7.0.0",
    "vant": "^4.10.2",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "5.7",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vue-tsc": "2.2"
  }
